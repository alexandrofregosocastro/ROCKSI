<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.1">
    <persistence-unit name="ROCKSIPU">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>


        <!-- Declaración manual de entidades -->
        <class>mx.desarollo.entity.Cliente</class>
        <class>mx.desarollo.entity.Clase</class>
        <class>mx.desarollo.entity.Cortecaja</class>
        <class>mx.desarollo.entity.Estainscrito</class>
        <class>mx.desarollo.entity.Item</class>
        <class>mx.desarollo.entity.Membresia</class>
        <class>mx.desarollo.entity.Paga</class>
        <class>mx.desarollo.entity.Producto</class>
        <class>mx.desarollo.entity.Reporte</class>
        <class>mx.desarollo.entity.Usuarioadministrador</class>
        <class>mx.desarollo.entity.Usuariorecepcionista</class>

        <properties>

            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/rocksi?zeroDateTimeBehavior=convertToNull&amp;autoReconnect=true"/>
            <property name="jakarta.persistence.jdbc.user" value="root"/>
            <property name="jakarta.persistence.jdbc.password" value="MangosYcocos"/>

            <!-- Configuración Hibernate -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.MySQLDialect"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
            <property name="hibernate.use_sql_comments" value="true"/>
            <property name="hibernate.enable_lazy_load_no_trans" value="true"/>

            <property name="hibernate.hikari.minimumIdle" value="5"/>
            <property name="hibernate.hikari.maximumPoolSize" value="10"/>
            <property name="hibernate.hikari.idleTimeout" value="30000"/>

        </properties>
    </persistence-unit>
</persistence>

